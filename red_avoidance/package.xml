<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>red_avoidance</name>
  <version>0.1.0</version>
  <description>Red-zone map and avoidance navigator (avoidance.py from Shiva007-RAndom/Qr-and-red-zone-detection) plus the zone frame; no ROS</description>
  <maintainer email="harrydybalaforever123@gmail.com">AeroTHON team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
