<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bc_sim</name>
  <version>0.1.0</version>
  <description>Simulation environment for the banner-corridor mission: Gazebo Harmonic world (AeroTHON 2026
    Mission 2, ground banners), ArduCopter SITL + MAVProxy + MAVROS launch, downward camera bridge.</description>
  <maintainer email="harrydybalaforever123@gmail.com">AeroTHON team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>bc_common</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>mavros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-opencv</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
