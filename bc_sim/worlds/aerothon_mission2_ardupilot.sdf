<?xml version="1.0" encoding="UTF-8"?>
<!--
  AEROTHON 2026 Flight Mission 2 world for ArduCopter SITL (ardupilot_gazebo, JSON, lock-step), banner-corridor
  workspace version of Shiva007-RAndom/Qr-and-red-zone-detection worlds/aerothon_mission2.sdf (v6-2026-09-30).

  Changes from the repo world:
    - ArduPilot physics: 1 ms step (ardupilot_gazebo needs it for lock-step) + the system plugins the
      ArduPilotPlugin and the camera need (physics, sensors/ogre2, user commands, scene broadcaster, IMU).
    - The two overhead "AEROTHON 2026" banners on posts (banner_forward_entry / banner_return_entry) are
      REMOVED: the banners are now on the GROUND, one per lane at its end:
        green_banner_ground (entry, #00B140)  across the forward lane just before its entrance:
                                              centre (2.8, 21.75), spans Y 20.0-23.5
        blue_banner_ground  (exit,  #0000FF)  across the return lane just past its room-side end:
                                              centre (13.2, 18.25), spans Y 16.5-20.0, turned 180 deg
      Both 11.5 ft x 1 ft (3.5052 x 0.3048 m), 1-inch white border, "AEROTHON 2026".
    - The vehicle is included: iris_down_cam (iris_with_ardupilot + fixed downward camera) on the pad,
      yaw 0 = facing +X (down the corridor).
  Everything else (pad, start QR, two-lane corridor, obstacles, room, red zone, candidate QRs) is unchanged.

  COORDINATE FRAME (Gazebo ENU; ArduPilot NED: north = +Y, east = +X)
    World origin = 13.0827 N, 80.2707 E, 10 m (sitl.launch.py starts SITL with this home).
    Launch pad centre (0, 20)        drone spawn, i.e. the EKF origin is 20 m north of the world origin
    Start QR (2, 20)                 = qr_b (the reference)
    Corridor X 3-13: lane_forward Y 20-23.5 (clear), lane_return Y 16.5-20 (2 box obstacles, 1.2 m)
    Room X 13-53, Y 0-40, walls 2.5 m, open top (bc_sim/config/delivery_zone.gazebo.txt)
    Red zone centre (32, 8.5), 8 x 8 m;  QRs: a (20, 32), b (18, 8) = match, c (24, 4), d (46, 7.5)

  Mission at 5 m transit / 3 m corridor: surges to X 4 over the corridor walls (1.5 m), sways left (+Y)
  onto the green banner, flies the forward lane at 3 m, ... blue search starts 11 m past the green banner
  (X 13.8, facing -X) and sways left (-Y) onto the blue banner, return lane at 3 m (over the 1.2 m boxes).
-->
<sdf version="1.9">
  <world name="aerothon_mission2_ardupilot">

    <!-- ardupilot_gazebo lock-step: 1 kHz physics, as in its iris_runway world -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= GROUND ================= -->
    <model name="ground_plane">
      <static>true</static>
      <pose>25 20 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>56 46</size></plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>56 46</size></plane>
          </geometry>
          <material>
            <ambient>0.30 0.45 0.20 1</ambient>
            <diffuse>0.35 0.55 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.3 0.4 -0.8</direction>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot><inner_angle>0</inner_angle><outer_angle>0</outer_angle><falloff>0</falloff></spot>
    </light>

    <!-- ================= LAUNCH PAD + START QR ================= -->
    <include>
      <uri>model://takeoff_pad</uri>
      <name>takeoff_pad</name>
      <pose>0 20 0.0 0 0 0</pose>
    </include>

    <include>
      <uri>model://qr_start</uri>
      <name>qr_start</name>
      <pose>2 20 0.001 0 0 0</pose>
    </include>

    <!-- ================= CORRIDOR - ENTRY APPROACH (X: 3 to 13) ================= -->
    <!-- lane_forward: Y [20,23.5] - outbound, NO obstacles
         lane_return:  Y [16.5,20] - return trip, 2 freestanding box obstacles -->

    <!-- GROUND BANNERS (replace the repo's overhead banner_forward_entry / banner_return_entry).
         Model long side = its X axis: yaw -90 deg lays it across the forward lane (Y 20-23.5), text upright
         for a drone heading +X; the blue one is turned 180 deg (yaw +90) for the drone coming back (-X).
         The green one spans X 2.65-2.95: 5 cm short of the corridor (X 3), 15 cm clear of the start QR (X 1.5-2.5). -->
    <include>
      <uri>model://green_banner_ground</uri>
      <name>green_banner_entry</name>
      <pose>2.8 21.75 0.002 0 0 -1.5707963</pose>
    </include>
    <include>
      <uri>model://blue_banner_ground</uri>
      <name>blue_banner_exit</name>
      <pose>13.2 18.25 0.002 0 0 1.5707963</pose>
    </include>

    <!-- Corridor walls: outer(y=16.5), divider(y=20), outer(y=23.5); 10 m, 1.5 m tall -->
    <model name="corridor_wall_outer_low">
      <static>true</static>
      <pose>8 16.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.1 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_wall_divider">
      <static>true</static>
      <pose>8 20 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.1 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_wall_outer_high">
      <static>true</static>
      <pose>8 23.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.1 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static obstacles - RETURN LANE ONLY (Y 16.5-20), freestanding boxes,
         staggered to force weaving. lane_forward (Y 20-23.5) is
         intentionally left clear - no obstacles. -->
    <include>
      <uri>model://black_obstacle</uri>
      <name>obstacle_1</name>
      <pose>6 17.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://black_obstacle</uri>
      <name>obstacle_2</name>
      <pose>10 19.4 0 0 0 0</pose>
    </include>

    <!-- ================= ROOM (X: 13 to 53, Y: 0 to 40) - open top ================= -->
    <!-- West wall has a 7 m gap (Y 16.5-23.5) where the two-lane corridor enters. -->
    <model name="room_wall_west_south_segment">
      <static>true</static>
      <pose>13 8.25 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 16.5 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 16.5 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="room_wall_west_north_segment">
      <static>true</static>
      <pose>13 31.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 16.5 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 16.5 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="room_wall_east">
      <static>true</static>
      <pose>53 20 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 40.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 40.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="room_wall_south">
      <static>true</static>
      <pose>33 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40.1 0.1 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="room_wall_north">
      <static>true</static>
      <pose>33 40 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40.1 0.1 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Restricted / red zone to be avoided: center (32,8.5), 8m x 8m (X 28-36, Y 4.5-12.5).
         It sits on the sweep row Y=7.5 between qr_d (X=46) and qr_b (X=18), so the
         drone must go around it to reach qr_b. Row Y=2.5 passes 2 m south of it. -->
    <include>
      <uri>model://red_zone</uri>
      <name>red_zone_1</name>
      <pose>32 8.5 0.001 0 0 0</pose>
    </include>

    <!-- 4 candidate QR codes scattered in the room, clear of the red zone.
         The start QR (near the pad) is identical to qr_b: that is the reference.
         Sweep order c, d, b, a makes qr_b the third tile the drone finds. -->
    <include>
      <uri>model://qr_a</uri>
      <name>qr_target_a</name>
      <pose>20 32 0.001 0 0 0</pose>
    </include>
    <include>
      <uri>model://qr_b</uri>
      <name>qr_target_b</name>
      <pose>18 8 0.001 0 0 0</pose>
    </include>
    <include>
      <uri>model://qr_c</uri>
      <name>qr_target_c</name>
      <pose>24 4 0.001 0 0 0</pose>
    </include>
    <include>
      <uri>model://qr_d</uri>
      <name>qr_target_d</name>
      <pose>46 7.5 0.001 0 0 0</pose>
    </include>

    <!-- ================= VEHICLE ================= -->
    <!-- ArduCopter SITL (JSON) with a fixed downward camera, on the launch pad, facing +X (the corridor).
         z = 0.195 as ardupilot_gazebo's iris_runway (landing gear on the ground). -->
    <include>
      <uri>model://iris_down_cam</uri>
      <name>iris</name>
      <pose>0 20 0.195 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>13.0827</latitude_deg>
      <longitude_deg>80.2707</longitude_deg>
      <elevation>10</elevation>
    </spherical_coordinates>

  </world>
</sdf>
