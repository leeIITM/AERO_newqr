<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    iris_with_ardupilot (from ardupilot_gazebo: ArduPilotPlugin on UDP 9002, lock-step JSON SITL) plus a FIXED
    downward camera for the banner-corridor mission, standing in for the SIYI A8 mini held nadir by its gimbal.

    Camera: 1280 x 720, horizontal FOV 1.22 rad (= hfov_rad in bc_bringup/config/mission.yaml), 15 Hz,
    gz topic /bc/down_camera/image (bridged to ROS and restamped to /camera/image_raw by sitl.launch.py).
    Mounting: the camera's optical axis (+X of a gz camera) is pitched 90 deg to point down, so the image
    top is the body's forward direction and the image right is the body's right: the convention every
    detector in the workspace uses.

    The vehicle's own frame: +X forward. Spawned with yaw 0 it faces world +X, down the corridor.
    Needs GZ_SIM_RESOURCE_PATH to contain ardupilot_gazebo/models (sitl.launch.py sets it).
  -->
  <model name="iris_down_cam">
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="down_camera_link">
      <pose relative_to="iris_with_standoffs::base_link">0 0 -0.08 0 1.5707963 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.03 0.04 0.03</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="down_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>1</visualize>
        <topic>/bc/down_camera/image</topic>
        <camera name="down_camera">
          <horizontal_fov>1.22</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>200</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="down_camera_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>down_camera_link</child>
    </joint>
  </model>
</sdf>
