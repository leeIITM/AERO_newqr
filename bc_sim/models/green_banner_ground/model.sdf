<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- AeroTHON 2026 corridor entry banner (green #00B140), on the ground.
       3.5052 m x 0.3048 m (11.5 ft x 1 ft), 1-inch white border, "AEROTHON 2026".
       Long side along the model's X axis; lies flat, top face at z = 0.01. Generated by
       bc_sim/scripts/make_banner_textures.py. -->
  <model name="green_banner_ground">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>3.5052 0.3048 0.01</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/green_banner_ground.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
