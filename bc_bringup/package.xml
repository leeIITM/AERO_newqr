<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bc_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and field parameter files for the banner-corridor mission</description>
  <maintainer email="harrydybalaforever123@gmail.com">AeroTHON team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>flight_controller</exec_depend>
  <exec_depend>bench_flight_controller</exec_depend>
  <exec_depend>siyi_camera</exec_depend>
  <exec_depend>banner_detector</exec_depend>
  <exec_depend>qr_detector</exec_depend>
  <exec_depend>banner_search</exec_depend>
  <exec_depend>banner_align</exec_depend>
  <exec_depend>corridor_navigator</exec_depend>
  <exec_depend>red_zone_detector</exec_depend>
  <exec_depend>target_search</exec_depend>
  <exec_depend>red_avoidance</exec_depend>
  <exec_depend>qr_centering</exec_depend>
  <exec_depend>mission_hud</exec_depend>
  <exec_depend>mission_management</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
