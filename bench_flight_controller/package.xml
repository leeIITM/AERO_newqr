<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bench_flight_controller</name>
  <version>0.1.0</version>
  <description>Drop-in bench replacement for flight_controller (simulated kinematics, optional real motor spin in GUIDED_NOGPS) and a synthetic downward camera</description>
  <maintainer email="harrydybalaforever123@gmail.com">AeroTHON team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>mission_interfaces</depend>
  <depend>bc_common</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
